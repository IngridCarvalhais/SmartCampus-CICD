# Credenciales de desarrollo local para Docker Compose.
# Cambia estos valores si el entorno se comparte con otros usuarios.
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_local_dev

# Compose genera DATABASE_URL para el backend con el servicio "database"
# como host: postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}