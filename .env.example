# Puertos publicados en el equipo local.
API_PORT=8000
FRONTEND_PORT=8080

# Solo se utilizan con: docker compose --profile postgres up
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=replace-before-use

# Por defecto Compose usa SQLite en el volumen persistente sqlite-data.
# Para PostgreSQL, define DATABASE_URL con credenciales locales y URL-encoded:
# postgresql+psycopg://usuario:contraseña@database:5432/smartcampus