apiVersion: v1
kind: Secret
metadata:
  name: smartcampus-db-credentials
  namespace: smartcampus
type: Opaque
stringData:
  POSTGRES_USER: "REPLACE_WITH_DATABASE_USER"
  POSTGRES_PASSWORD: "REPLACE_WITH_URL_SAFE_PASSWORD"
  DATABASE_URL: "postgresql+psycopg://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_URL_SAFE_PASSWORD@postgresql:5432/smartcampus"
